# ArgusTrace Frontend Environment Variables
# If deploying on Vercel with a separately hosted backend (e.g. Render, Railway, Fly.io):
# Set this to your live backend domain (do not include the trailing /api):
# VITE_API_URL=https://your-argustrace-backend.onrender.com
#
# If left empty, the frontend defaults to '/api' (ideal for local dev proxy or Vercel edge rewrites).
VITE_API_URL=
