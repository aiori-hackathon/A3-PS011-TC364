# ArgusTrace Backend Environment Variables (Production & Lab Template)
PROJECT_NAME="ArgusTrace - Attack Surface Asset Discovery & Risk Intelligence (PS-011)"
API_V1_STR="/api"
DATABASE_URL="sqlite:///./argustrace.db"

# Allowed CORS Origins (JSON list or local dev origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","https://a3-ps011-tc364.vercel.app"]

# Discovery Limits & Safety Guardrails
MAX_CONCURRENT_PROBES=10
TCP_TIMEOUT_SECONDS=3.0
HTTP_TIMEOUT_SECONDS=5.0
DNS_TIMEOUT_SECONDS=3.0
MAX_PORTS_PER_SCAN=50

# Phase 5: Notifications & External Integrations (Disabled by default)
ENABLE_LIVE_NOTIFICATIONS=false
WEBHOOK_TIMEOUT_SECONDS=5.0
MAX_NOTIFICATION_RETRIES=3

# Optional SMTP Settings (leave empty/unconfigured to safely keep email disabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="argustrace@security.internal"
SMTP_TLS=true
